{
  // Site estático publicado na Cloudflare (Workers com arquivos estáticos).
  // O que não deve ir para o ar fica listado em .assetsignore.
  "name": "minha-landign-page",
  "compatibility_date": "2026-09-01",
  // O script só redireciona o www para o endereço principal.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
