{
  // Site estático publicado na Cloudflare (Workers com arquivos estáticos).
  // O que não deve ir para o ar fica listado em .assetsignore.
  "name": "minha-landign-page",
  "compatibility_date": "2026-09-01",
  // O script redireciona o www e acrescenta os cabeçalhos de segurança.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Endereços que não existem mostram a página 404.html.
    "not_found_handling": "404-page"
  }
}
